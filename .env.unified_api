# ============================================================================
# SUPPORTED PAGE TYPES (Automatic Detection)
# ============================================================================
#
# 1. Company Pages:
#    - exportgenius.in/company/{company-name}
#    - marketinside.com/company/{company-name}
#    Endpoint: /company-data
#
# 2. Country Pages:
#    - exportgenius.in/country/{country-name}
#    - marketinside.com/country/{country-name}
#    Endpoints: /country-import-data, /country-export-data
#
# 3. Search Data Pages (NEW):
#    - exportgenius.in/en/search-data/trade?type=import&country=india&product=copper
#    - marketinside.com/en/search-data/importer?type=export&country=usa&hs_code=1234
#    Endpoints: /search-data-product, /search-data-importers, /search-data-exporters,
#               /search-data-buyers, /search-data-suppliers, etc.
#
# ============================================================================

# Site Configuration (for multi-site deployments)
SITE_ID=marketinside
SITE_NAME=Marketinside

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL_DAYS=7

# Ollama Configuration (for embeddings and LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=deepseek-v3.1:671b-cloud

# Knowledge Base Files (auto-detects based on SITE_ID)
KB_CHUNKS_FILE=data/kb_marketinside_chunks.json
FAISS_INDEX_FILE=data/faiss_marketinside_normalized.index
