# ============================================================
# Next.js Environment Variables for Chatbot Integration
# Copy this to your Next.js project as .env.local
# ============================================================

# Chatbot API URL (your deployed backend)
# This is the URL where your FastAPI chatbot is running
NEXT_PUBLIC_CHATBOT_API_URL=https://chatbot.exportgenius.in

# Chatbot Widget URL (the compiled chat-widget.js file)
# This is served by Nginx from your server
NEXT_PUBLIC_CHATBOT_WIDGET_URL=https://chatbot.exportgenius.in/chat-widget.js

# ============================================================
# Development URLs (use when running locally)
# ============================================================
# NEXT_PUBLIC_CHATBOT_API_URL=http://localhost:8000
# NEXT_PUBLIC_CHATBOT_WIDGET_URL=http://localhost:5173/src/main.tsx
