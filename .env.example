# ============================================================================
# MI Chat Bot - Environment Configuration
# Copy this file to .env and configure for your deployment
# Keep your .env file secure and never commit to git
# ============================================================================

# ----------------------------------------------------------------------------
# API Authentication (Optional - for dynamic content fetching)
# ----------------------------------------------------------------------------
# Export Genius API bearer token
# Get this from your Export Genius account dashboard
EXPORT_GENIUS_BEARER_TOKEN=

# Market Inside API bearer token
# Get this from your Market Inside account dashboard
MARKETINSIDE_BEARER_TOKEN=

# Example format (DO NOT USE - replace with your actual tokens):
# EXPORT_GENIUS_BEARER_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# MARKETINSIDE_BEARER_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------------------------------
# Site Configuration (Multi-Site Support)
# ----------------------------------------------------------------------------
# Site identifier - determines which knowledge base to use
# Options: exportgenius, marketinside
SITE_ID=exportgenius

# Site display name (shown in chatbot responses)
SITE_NAME=Export Genius

# Knowledge base data files (auto-selected based on SITE_ID)
KB_CHUNKS_FILE=data/kb_exportgenius_chunks.json
FAISS_INDEX_FILE=data/faiss_exportgenius_normalized.index

# For Market Inside site, use:
# SITE_ID=marketinside
# SITE_NAME=Market Inside Data
# KB_CHUNKS_FILE=data/kb_marketinside_chunks.json
# FAISS_INDEX_FILE=data/faiss_marketinside_normalized.index

# ----------------------------------------------------------------------------
# Redis Configuration (Required for conversation memory and caching)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL_DAYS=7

# For multi-site deployments, use different Redis DB numbers:
# Export Genius: REDIS_DB=0
# Market Inside: REDIS_DB=2

# ----------------------------------------------------------------------------
# Ollama Configuration (Required for LLM and embeddings)
# ----------------------------------------------------------------------------
# LLM model for chat responses
LLM_MODEL=deepseek-v3.1:671b-cloud

# Embedding model for vector search (RAG)
EMBEDDING_MODEL=nomic-embed-text

# Ollama server URL
# Local: http://localhost:11434
# Cloud: https://ollama.com (requires API key)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama Cloud API key (optional - only needed if using cloud API)
OLLAMA_API_KEY=

# ----------------------------------------------------------------------------
# API Server Configuration
# ----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ----------------------------------------------------------------------------
# Performance Tuning (Optional)
# ----------------------------------------------------------------------------
# Disable checkpointing for 10-15s faster responses (loses conversation history)
DISABLE_CHECKPOINTING=false

# Enable detailed performance logging
ENABLE_PERFORMANCE_LOGGING=true

# ----------------------------------------------------------------------------
# MySQL Configuration (For FAQ/Suggested Questions)
# ----------------------------------------------------------------------------
# Enable FAQ system for page-specific suggested questions
FAQ_ENABLED=true

# MySQL connection settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=chatbot
MYSQL_POOL_SIZE=5

# Note: If MySQL is unavailable, the system falls back to LLM-generated questions
# Run chatbot/database/schema.sql to create the required tables

# ----------------------------------------------------------------------------
# Production Settings (Optional)
# ----------------------------------------------------------------------------
# ENVIRONMENT=production
# LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# OpenAI API (Deprecated - Not recommended)
# ----------------------------------------------------------------------------
# We use local Ollama embeddings for 10-20x faster performance
# OpenAI API is deprecated but kept for legacy compatibility
# OPENAI_API_KEY=
